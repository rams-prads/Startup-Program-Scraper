# Pick one backend and fill in its key. Everything here is a free tier
# except the last one.

# Google AI Studio. Free, no card. Get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
GEMINI_API_KEY=

# Groq. Free, no card. Get a key at https://console.groq.com/keys
# LLM_PROVIDER=groq
# GROQ_API_KEY=

# OpenRouter free models. Get a key at https://openrouter.ai/keys
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=

# Ollama on your own machine. No key, no account. Install from https://ollama.com
# then run: ollama pull llama3.1:8b
# LLM_PROVIDER=ollama

# The paid path, only if you want the best quality on a run that matters.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
